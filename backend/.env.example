# Backend Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Server
PORT=5009
NODE_ENV=production

# Database - Get this from MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/stock-simulator?retryWrites=true&w=majority

# Auth
JWT_SECRET=<generate-a-strong-random-secret-min-32-chars>

# Frontend URL (set to your Vercel deployment URL)
FRONTEND_URL=https://<your-app>.vercel.app
CORS_ALLOWED_ORIGINS=https://<your-app>.vercel.app

# Stock Data
STOCK_DATA_PROVIDER=yahoo
YAHOO_CACHE_TTL=60
STOCK_SYMBOLS=AAPL,MSFT,NVDA,TSLA,META,AMZN,GOOGL,NFLX,RELIANCE.NS,TCS.NS,INFY.NS

# Email (Gmail SMTP with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=<gmail-app-password>
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Stock Market Dashboard
